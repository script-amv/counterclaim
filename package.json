{
  "name": "counterclaim",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "26.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "NODE_OPTIONS='--require ./scripts/build-env.cjs' next build --webpack",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "start": "next start",
    "assign-scenario": "node scripts/run-ts.mjs scripts/assign-scenario.ts",
    "eval": "node scripts/run-ts.mjs scripts/eval.ts",
    "seed-demo": "node scripts/run-ts.mjs scripts/seed-demo.ts",
    "e2e": "playwright test",
    "dev:offline": "NODE_OPTIONS='--require ./scripts/offline.cjs' next dev"
  },
  "dependencies": {
    "ag-grid-community": "^36.3.0",
    "ag-grid-react": "^36.3.0",
    "next": "^16.4.5",
    "pdf-lib": "^1.17.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.5",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0"
  },
  "type": "module"
}
